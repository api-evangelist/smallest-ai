  "info": {
    "_postman_id": "ec255ad6-12aa-4b8c-9a85-ac4df8ff9f54",
    "name": "Smallest AI Waves Streaming Voices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Smallest AI Waves text-to-speech API. Generates natural speech from text using the Lightning family of models with sub-100ms latency, streams audio in realtime over Server-Sent Events, lists prebuilt voices, and clones custom voices from short audio samples. All endpoints are authenticated with a Bearer API key. The realtime bidirectional WebSocket transport for streaming TTS is modeled in the companion AsyncAPI document (asyncapi/smallest-ai-asyncapi.yml).\n\nContact Support:\n Name: Smallest AI Support\n Email: support@smallest.ai",
      "type": "text/plain"
    }
  }
